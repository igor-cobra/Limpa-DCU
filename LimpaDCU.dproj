    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_DcuOutput>build\dcu\$(Platform)\$(Config)\</DCC_DcuOutput>
        <DCC_ExeOutput>bin\$(Platform)\$(Config)\</DCC_ExeOutput>
        <DCC_UnitSearchPath>src\Class;src\DataModule;src\Forms;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;$(DCC_Namespace)</DCC_Namespace>
        <Icon_MainIcon>assets\icons\LimpaDCU.ico</Icon_MainIcon>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_AutoIncVersion>false</VerInfo_AutoIncVersion>
        <VerInfo_MajorVer>2</VerInfo_MajorVer>
        <VerInfo_MinorVer>2</VerInfo_MinorVer>
        <VerInfo_Release>0</VerInfo_Release>
        <VerInfo_Build>0</VerInfo_Build>
        <VerInfo_Locale>1046</VerInfo_Locale>
        <VerInfo_Keys>CompanyName=SucoDev;FileDescription=LimpaDCU;FileVersion=2.2.0.0;InternalName=LimpaDCU;LegalCopyright=;LegalTrademarks=;OriginalFilename=LimpaDCU.exe;ProgramID=SucoDev.LimpaDCU;ProductName=LimpaDCU;ProductVersion=2.2.0.0;Comments=Utilitário de manutenção de artefatos Delphi</VerInfo_Keys>
        <SanitizedProjectName>LimpaDCU</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <AppDPIAwarenessMode>PerMonitorV2</AppDPIAwarenessMode>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64)'!=''">
        <AppDPIAwarenessMode>PerMonitorV2</AppDPIAwarenessMode>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
        <UsePackages>true</UsePackages>
        <DCC_UsePackage>rtl;vcl;vclx;vclwinx;dbrtl;vcldb;FireDAC;FireDACCommon;FireDACCommonDriver;FireDACSqliteDriver;vclFireDAC</DCC_UsePackage>
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
        <DCC_DebugInformation>2</DCC_DebugInformation>
        <DCC_RangeChecking>true</DCC_RangeChecking>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
        <DCC_AssertionsAtRuntime>true</DCC_AssertionsAtRuntime>
